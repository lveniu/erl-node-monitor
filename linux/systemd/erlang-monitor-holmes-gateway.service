[Unit]
Description=Erlang Monitor Holmes Gateway
Wants=network-online.target erlang-monitor-holmes.service erlang-monitor-exporter.service
After=network-online.target erlang-monitor-holmes.service erlang-monitor-prometheus.service erlang-monitor-exporter.service

[Service]
Type=simple
User=erlang-monitor
Group=erlang-monitor
WorkingDirectory=/data/node_monitor
UMask=0027
Environment=SSH_AUTH_SOCK=/run/erlang-monitor-ssh-agent/agent.sock
ExecStartPre=/usr/bin/test -S /run/erlang-monitor-ssh-agent/agent.sock
ExecStartPre=/usr/bin/ssh-add -l
ExecStartPre=/bin/bash /data/node_monitor/linux/run-holmes-gateway.sh --check
ExecStart=/bin/bash /data/node_monitor/linux/run-holmes-gateway.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
