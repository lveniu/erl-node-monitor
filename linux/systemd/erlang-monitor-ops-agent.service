[Unit]
Description=Erlang Monitor Operations Agent
Wants=network-online.target erlang-monitor-exporter.service
After=network-online.target erlang-monitor-exporter.service

[Service]
Type=simple
User=erlang-monitor
Group=erlang-monitor
WorkingDirectory=/home/qt/node_monitor
UMask=0027
Environment=SSH_AUTH_SOCK=/run/erlang-monitor-ssh-agent/agent.sock
Environment=OPS_AGENT_MODEL_API_KEY_FILE=/home/qt/node_monitor/secrets/glm_api_key
Environment=OPS_AGENT_TOOL_API_TOKEN_FILE=/home/qt/node_monitor/secrets/ops_agent_tool_api_token
ExecStartPre=/usr/bin/test -S /run/erlang-monitor-ssh-agent/agent.sock
ExecStartPre=/usr/bin/ssh-add -l
ExecStartPre=/home/qt/node_monitor/runtime/bin/ops-agent -config /home/qt/node_monitor/ops-agent/config.native.yml -servers /home/qt/node_monitor/config/servers.native.yml -check-config
ExecStart=/home/qt/node_monitor/runtime/bin/ops-agent -config /home/qt/node_monitor/ops-agent/config.native.yml -servers /home/qt/node_monitor/config/servers.native.yml -listen 127.0.0.1:20906
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false

[Install]
WantedBy=multi-user.target
