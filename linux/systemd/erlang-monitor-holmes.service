[Unit]
Description=Erlang Monitor HolmesGPT
Wants=network-online.target erlang-monitor-prometheus.service
After=network-online.target erlang-monitor-prometheus.service

[Service]
Type=simple
User=erlang-monitor
Group=erlang-monitor
WorkingDirectory=/opt/erlang-monitor/holmesgpt
UMask=0027
ExecStartPre=/usr/bin/test -s /data/node_monitor/holmes/model_list.local.yaml
ExecStartPre=/bin/bash /data/node_monitor/linux/run-holmes.sh --check
ExecStart=/bin/bash /data/node_monitor/linux/run-holmes.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
